<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:state_focused="true"
        android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tile_pressed_overlay" />
                    <corners android:radius="@dimen/tile_corner_radius" />
                </shape>
            </item>
            <item
                android:bottom="@dimen/tile_focus_ring_inset"
                android:left="@dimen/tile_focus_ring_inset"
                android:right="@dimen/tile_focus_ring_inset"
                android:top="@dimen/tile_focus_ring_inset">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="@dimen/tile_focus_ring_width"
                        android:color="@color/tile_focus_ring" />
                    <corners android:radius="@dimen/tile_focus_ring_corner_radius" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tile_focus_overlay" />
                    <corners android:radius="@dimen/tile_corner_radius" />
                </shape>
            </item>
            <item
                android:bottom="@dimen/tile_focus_ring_inset"
                android:left="@dimen/tile_focus_ring_inset"
                android:right="@dimen/tile_focus_ring_inset"
                android:top="@dimen/tile_focus_ring_inset">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="@dimen/tile_focus_ring_width"
                        android:color="@color/tile_focus_ring" />
                    <corners android:radius="@dimen/tile_focus_ring_corner_radius" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_pressed_overlay" />
            <corners android:radius="@dimen/tile_corner_radius" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/tile_corner_radius" />
        </shape>
    </item>

</selector>
